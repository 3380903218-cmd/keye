  <library>
    <event name="HY5417_Public_History">
      <project name="HY5417_Chinatown_v01_English_r2">
        <sequence format="fmt" duration="600s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
          <spine>
            <asset-clip name="000.00_S03" ref="a3" offset="0/25s" start="50/25s" duration="175/25s">
              <adjust-transform position="0 5" scale="0.77 0.77" />
              <adjust-volume amount="-28dB" />
              <asset-clip ref="voice1" name="EN narration 01 (replaceable)" lane="-1" offset="100/25s" start="0s" duration="672/25s" audioRole="dialogue" />
              <asset-clip ref="voice2" name="EN narration 02 (replaceable)" lane="-1" offset="1100/25s" start="0s" duration="547/25s" audioRole="dialogue" />
              <asset-clip ref="voice3" name="EN narration 03 (replaceable)" lane="-1" offset="1675/25s" start="0s" duration="498/25s" audioRole="dialogue" />
              <asset-clip ref="voice4" name="EN narration 04 (replaceable)" lane="-1" offset="2200/25s" start="0s" duration="549/25s" audioRole="dialogue" />
              <asset-clip ref="voice5" name="EN narration 05 (replaceable)" lane="-1" offset="2850/25s" start="0s" duration="523/25s" audioRole="dialogue" />
              <asset-clip ref="voice6" name="EN narration 06 (replaceable)" lane="-1" offset="3400/25s" start="0s" duration="569/25s" audioRole="dialogue" />
              <asset-clip ref="voice7" name="EN narration 07 (replaceable)" lane="-1" offset="4000/25s" start="0s" duration="451/25s" audioRole="dialogue" />
              <asset-clip ref="voice8" name="EN narration 08 (replaceable)" lane="-1" offset="4600/25s" start="0s" duration="548/25s" audioRole="dialogue" />
              <asset-clip ref="voice9" name="EN narration 09 (replaceable)" lane="-1" offset="5450/25s" start="0s" duration="598/25s" audioRole="dialogue" />
              <asset-clip ref="voice10" name="EN narration 10 (replaceable)" lane="-1" offset="6500/25s" start="0s" duration="729/25s" audioRole="dialogue" />
              <asset-clip ref="voice11" name="EN narration 11 (replaceable)" lane="-1" offset="7375/25s" start="0s" duration="796/25s" audioRole="dialogue" />
              <asset-clip ref="voice12" name="EN narration 12 (replaceable)" lane="-1" offset="8675/25s" start="0s" duration="589/25s" audioRole="dialogue" />
              <asset-clip ref="voice13" name="EN narration 13 (replaceable)" lane="-1" offset="9325/25s" start="0s" duration="598/25s" audioRole="dialogue" />
              <asset-clip ref="voice14" name="EN narration 14 (replaceable)" lane="-1" offset="10375/25s" start="0s" duration="571/25s" audioRole="dialogue" />
              <asset-clip ref="voice15" name="EN narration 15 (replaceable)" lane="-1" offset="11025/25s" start="0s" duration="622/25s" audioRole="dialogue" />
              <asset-clip ref="voice16" name="EN narration 16 (replaceable)" lane="-1" offset="11675/25s" start="0s" duration="525/25s" audioRole="dialogue" />
              <asset-clip ref="voice17" name="EN narration 17 (replaceable)" lane="-1" offset="12375/25s" start="0s" duration="512/25s" audioRole="dialogue" />
              <asset-clip ref="voice18" name="EN narration 18 (replaceable)" lane="-1" offset="12925/25s" start="0s" duration="548/25s" audioRole="dialogue" />
              <asset-clip ref="voice19" name="EN narration 19 (replaceable)" lane="-1" offset="13500/25s" start="0s" duration="597/25s" audioRole="dialogue" />
              <title ref="text" name="EN subtitle" lane="2" offset="100/25s" start="0s" duration="139/25s" role="titles">
                <text>
                  <text-style ref="ts1">Walk into Singapore's Chinatown, and the shophouses are often
the first thing you notice.</text-style>
                </text>
                <text-style-def id="ts1">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="256/25s" start="0s" duration="104/25s" role="titles">
                <text>
                  <text-style ref="ts2">Yet the history of a street also lives in everyday encounters:</text-style>
                </text>
                <text-style-def id="ts2">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="360/25s" start="0s" duration="142/25s" role="titles">
                <text>
                  <text-style ref="ts3">buying food, running a business, sharing
skills, and returning to familiar places.</text-style>
                </text>
                <text-style-def id="ts3">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="519/25s" start="0s" duration="103/25s" role="titles">
                <text>
                  <text-style ref="ts4">When the buildings survive, what
helps these relationships continue?</text-style>
                </text>
                <text-style-def id="ts4">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="640/25s" start="0s" duration="115/25s" role="titles">
                <text>
                  <text-style ref="ts5">This film follows that question through the streets and one
working tea business.</text-style>
                </text>
                <text-style-def id="ts5">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="1100/25s" start="0s" duration="86/25s" role="titles">
                <text>
                  <text-style ref="ts6">Chinatown grew through migration, trade and settlement.</text-style>
                </text>
                <text-style-def id="ts6">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="1198/25s" start="0s" duration="89/25s" role="titles">
                <text>
                  <text-style ref="ts7">Its shophouses connected work and home, with business on the</text-style>
                </text>
                <text-style-def id="ts7">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="1288/25s" start="0s" duration="54/25s" role="titles">
                <text>
                  <text-style ref="ts8">ground floor and living space above.</text-style>
                </text>
                <text-style-def id="ts8">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="1354/25s" start="0s" duration="95/25s" role="titles">
                <text>
                  <text-style ref="ts9">The historic district contains several different precincts.</text-style>
                </text>
                <text-style-def id="ts9">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="1460/25s" start="0s" duration="92/25s" role="titles">
                <text>
                  <text-style ref="ts10">Here, a small selection of streets offers a starting point,</text-style>
                </text>
                <text-style-def id="ts10">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="1553/25s" start="0s" duration="83/25s" role="titles">
                <text>
                  <text-style ref="ts11">rather than a complete picture of the whole district.</text-style>
                </text>
                <text-style-def id="ts11">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="1675/25s" start="0s" duration="127/25s" role="titles">
                <text>
                  <text-style ref="ts12">Remembering an earlier Chinatown does not mean that every part
of its past should return.</text-style>
                </text>
                <text-style-def id="ts12">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="1810/25s" start="0s" duration="92/25s" role="titles">
                <text>
                  <text-style ref="ts13">Older housing also faced overcrowding and poor sanitation.</text-style>
                </text>
                <text-style-def id="ts13">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="1911/25s" start="0s" duration="57/25s" role="titles">
                <text>
                  <text-style ref="ts14">People needed better living conditions.</text-style>
                </text>
                <text-style-def id="ts14">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="1976/25s" start="0s" duration="97/25s" role="titles">
                <text>
                  <text-style ref="ts15">Conservation therefore involves choices about what to retain,</text-style>
                </text>
                <text-style-def id="ts15">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="2073/25s" start="0s" duration="92/25s" role="titles">
                <text>
                  <text-style ref="ts16">what to improve, and whose needs should guide those changes.</text-style>
                </text>
                <text-style-def id="ts16">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="2200/25s" start="0s" duration="148/25s" role="titles">
                <text>
                  <text-style ref="ts17">On the seventh of July, nineteen eighty-nine, Chinatown
received conservation status.</text-style>
                </text>
                <text-style-def id="ts17">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="2354/25s" start="0s" duration="92/25s" role="titles">
                <text>
                  <text-style ref="ts18">This helped protect its architectural
and historical character.</text-style>
                </text>
                <text-style-def id="ts18">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="2452/25s" start="0s" duration="77/25s" role="titles">
                <text>
                  <text-style ref="ts19">But keeping a building and sustaining its use are related</text-style>
                </text>
                <text-style-def id="ts19">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="2529/25s" start="0s" duration="48/25s" role="titles">
                <text>
                  <text-style ref="ts20">questions with different answers.</text-style>
                </text>
                <text-style-def id="ts20">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="2584/25s" start="0s" duration="89/25s" role="titles">
                <text>
                  <text-style ref="ts21">A restored facade alone cannot
tell us whether people still have</text-style>
                </text>
                <text-style-def id="ts21">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="2673/25s" start="0s" duration="70/25s" role="titles">
                <text>
                  <text-style ref="ts22">the conditions to live, work and gather around it.</text-style>
                </text>
                <text-style-def id="ts22">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="2850/25s" start="0s" duration="107/25s" role="titles">
                <text>
                  <text-style ref="ts23">Festivals make Chinatown's cultural
identity especially visible.</text-style>
                </text>
                <text-style-def id="ts23">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="2964/25s" start="0s" duration="92/25s" role="titles">
                <text>
                  <text-style ref="ts24">Lights and markets bring people together, while exhibitions</text-style>
                </text>
                <text-style-def id="ts24">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="3056/25s" start="0s" duration="56/25s" role="titles">
                <text>
                  <text-style ref="ts25">introduce visitors to earlier lives.</text-style>
                </text>
                <text-style-def id="ts25">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="3120/25s" start="0s" duration="64/25s" role="titles">
                <text>
                  <text-style ref="ts26">These are valuable ways of sharing history.</text-style>
                </text>
                <text-style-def id="ts26">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="3191/25s" start="0s" duration="91/25s" role="titles">
                <text>
                  <text-style ref="ts27">The festival footage here records Chinese New Year in twenty</text-style>
                </text>
                <text-style-def id="ts27">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="3282/25s" start="0s" duration="84/25s" role="titles">
                <text>
                  <text-style ref="ts28">twenty-five, rather than an ordinary day on the street.</text-style>
                </text>
                <text-style-def id="ts28">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="3400/25s" start="0s" duration="81/25s" role="titles">
                <text>
                  <text-style ref="ts29">The rooms inside the Chinatown Heritage Centre are</text-style>
                </text>
                <text-style-def id="ts29">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="3481/25s" start="0s" duration="100/25s" role="titles">
                <text>
                  <text-style ref="ts30">reconstructions, designed to help visitors imagine the past.</text-style>
                </text>
                <text-style-def id="ts30">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="3598/25s" start="0s" duration="76/25s" role="titles">
                <text>
                  <text-style ref="ts31">They should not be mistaken for historical film.</text-style>
                </text>
                <text-style-def id="ts31">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="3692/25s" start="0s" duration="115/25s" role="titles">
                <text>
                  <text-style ref="ts32">Alongside these displays, another
question remains: how do people</text-style>
                </text>
                <text-style-def id="ts32">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="3806/25s" start="0s" duration="97/25s" role="titles">
                <text>
                  <text-style ref="ts33">use the district today, outside the moments selected for</text-style>
                </text>
                <text-style-def id="ts33">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="3903/25s" start="0s" duration="48/25s" role="titles">
                <text>
                  <text-style ref="ts34">celebration or exhibition?</text-style>
                </text>
                <text-style-def id="ts34">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="4000/25s" start="0s" duration="106/25s" role="titles">
                <text>
                  <text-style ref="ts35">These street images show shops,
goods and people passing through.</text-style>
                </text>
                <text-style-def id="ts35">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="4123/25s" start="0s" duration="80/25s" role="titles">
                <text>
                  <text-style ref="ts36">They cannot tell us who is a resident or a tourist, or</text-style>
                </text>
                <text-style-def id="ts36">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="4203/25s" start="0s" duration="52/25s" role="titles">
                <text>
                  <text-style ref="ts37">how long a business has been here.</text-style>
                </text>
                <text-style-def id="ts37">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="4273/25s" start="0s" duration="104/25s" role="titles">
                <text>
                  <text-style ref="ts38">They encourage a closer question:
what makes this a place people</text-style>
                </text>
                <text-style-def id="ts38">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="4376/25s" start="0s" duration="58/25s" role="titles">
                <text>
                  <text-style ref="ts39">can keep using, as well as visiting?</text-style>
                </text>
                <text-style-def id="ts39">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="4600/25s" start="0s" duration="73/25s" role="titles">
                <text>
                  <text-style ref="ts40">Revitalisation can take different forms.</text-style>
                </text>
                <text-style-def id="ts40">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="4685/25s" start="0s" duration="111/25s" role="titles">
                <text>
                  <text-style ref="ts41">In November twenty twenty-three,
CNA reported plans for a single</text-style>
                </text>
                <text-style-def id="ts41">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="4796/25s" start="0s" duration="117/25s" role="titles">
                <text>
                  <text-style ref="ts42">master tenant to manage a row of
thirteen shophouses on Smith Street.</text-style>
                </text>
                <text-style-def id="ts42">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="4924/25s" start="0s" duration="93/25s" role="titles">
                <text>
                  <text-style ref="ts43">The aim was to attract people while
retaining the area's heritage.</text-style>
                </text>
                <text-style-def id="ts43">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="5028/25s" start="0s" duration="108/25s" role="titles">
                <text>
                  <text-style ref="ts44">Existing businesses also had concerns
about what change might bring.</text-style>
                </text>
                <text-style-def id="ts44">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="5181/25s" start="0s" duration="109/25s" role="titles">
                <text>
                  <text-style ref="ts45">He wishes to stay on under the new master tenant</text-style>
                </text>
                <text-style-def id="ts45">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="5290/25s" start="0s" duration="110/25s" role="titles">
                <text>
                  <text-style ref="ts46">but hopes the rejuvenation project won't over-commercialise
the area and drive up rents.</text-style>
                </text>
                <text-style-def id="ts46">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="5450/25s" start="0s" duration="88/25s" role="titles">
                <text>
                  <text-style ref="ts47">A separate CNA report in May twenty twenty-five examined</text-style>
                </text>
                <text-style-def id="ts47">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="5538/25s" start="0s" duration="110/25s" role="titles">
                <text>
                  <text-style ref="ts48">collaboration between businesses
and the Chinatown Heritage Centre.</text-style>
                </text>
                <text-style-def id="ts48">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="5662/25s" start="0s" duration="139/25s" role="titles">
                <text>
                  <text-style ref="ts49">Some interviewed businesses described improved sales,
alongside continuing pressures.</text-style>
                </text>
                <text-style-def id="ts49">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="5816/25s" start="0s" duration="43/25s" role="titles">
                <text>
                  <text-style ref="ts50">This was a different initiative.</text-style>
                </text>
                <text-style-def id="ts50">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="5874/25s" start="0s" duration="105/25s" role="titles">
                <text>
                  <text-style ref="ts51">These reports cannot, by themselves,
show that the earlier tender</text-style>
                </text>
                <text-style-def id="ts51">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="5979/25s" start="0s" duration="54/25s" role="titles">
                <text>
                  <text-style ref="ts52">caused those later improvements.</text-style>
                </text>
                <text-style-def id="ts52">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="6082/25s" start="0s" duration="57/25s" role="titles">
                <text>
                  <text-style ref="ts53">First of all is definitely the rental.</text-style>
                </text>
                <text-style-def id="ts53">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="6138/25s" start="0s" duration="126/25s" role="titles">
                <text>
                  <text-style ref="ts54">Yeah, in this location, definitely it's not going to be low.</text-style>
                </text>
                <text-style-def id="ts54">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="6286/25s" start="0s" duration="161/25s" role="titles">
                <text>
                  <text-style ref="ts55">And subsequently, I think for us, manpower is a challenge.</text-style>
                </text>
                <text-style-def id="ts55">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="6500/25s" start="0s" duration="65/25s" role="titles">
                <text>
                  <text-style ref="ts56">More customers can help a business survive.</text-style>
                </text>
                <text-style-def id="ts56">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="6583/25s" start="0s" duration="115/25s" role="titles">
                <text>
                  <text-style ref="ts57">But sales, costs and the ability to
stay must be considered together.</text-style>
                </text>
                <text-style-def id="ts57">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="6715/25s" start="0s" duration="99/25s" role="titles">
                <text>
                  <text-style ref="ts58">Shopkeepers are not necessarily long-term residents, and</text-style>
                </text>
                <text-style-def id="ts58">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="6815/25s" start="0s" duration="52/25s" role="titles">
                <text>
                  <text-style ref="ts59">residents do not all run shops.</text-style>
                </text>
                <text-style-def id="ts59">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="6884/25s" start="0s" duration="102/25s" role="titles">
                <text>
                  <text-style ref="ts60">A benefit for one group does not automatically reach everyone.</text-style>
                </text>
                <text-style-def id="ts60">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="7003/25s" start="0s" duration="103/25s" role="titles">
                <text>
                  <text-style ref="ts61">The useful question is how tourism
income supports continued use,</text-style>
                </text>
                <text-style-def id="ts61">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="7107/25s" start="0s" duration="105/25s" role="titles">
                <text>
                  <text-style ref="ts62">and which needs remain outside the
measures of commercial success.</text-style>
                </text>
                <text-style-def id="ts62">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="7375/25s" start="0s" duration="98/25s" role="titles">
                <text>
                  <text-style ref="ts63">Pek Sin Choon brings these questions
into a working tea business.</text-style>
                </text>
                <text-style-def id="ts63">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="7490/25s" start="0s" duration="67/25s" role="titles">
                <text>
                  <text-style ref="ts64">My street footage records its shopfront.</text-style>
                </text>
                <text-style-def id="ts64">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="7575/25s" start="0s" duration="98/25s" role="titles">
                <text>
                  <text-style ref="ts65">The interior scenes that follow come from a National Heritage</text-style>
                </text>
                <text-style-def id="ts65">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="7672/25s" start="0s" duration="68/25s" role="titles">
                <text>
                  <text-style ref="ts66">Board film, published by Roots Singapore.</text-style>
                </text>
                <text-style-def id="ts66">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="7758/25s" start="0s" duration="110/25s" role="titles">
                <text>
                  <text-style ref="ts67">They show a form of heritage
carried through practice: selecting,</text-style>
                </text>
                <text-style-def id="ts67">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="7867/25s" start="0s" duration="98/25s" role="titles">
                <text>
                  <text-style ref="ts68">blending and tasting tea, handling materials, and passing</text-style>
                </text>
                <text-style-def id="ts68">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="7965/25s" start="0s" duration="47/25s" role="titles">
                <text>
                  <text-style ref="ts69">experience to other people.</text-style>
                </text>
                <text-style-def id="ts69">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="8029/25s" start="0s" duration="124/25s" role="titles">
                <text>
                  <text-style ref="ts70">The building matters, and so does the knowledge that people
continue to use inside it.</text-style>
                </text>
                <text-style-def id="ts70">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="8675/25s" start="0s" duration="74/25s" role="titles">
                <text>
                  <text-style ref="ts71">This is one way to understand living heritage.</text-style>
                </text>
                <text-style-def id="ts71">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="8766/25s" start="0s" duration="113/25s" role="titles">
                <text>
                  <text-style ref="ts72">Continuity depends on people
continuing to do things, learn them,</text-style>
                </text>
                <text-style-def id="ts72">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="8879/25s" start="0s" duration="54/25s" role="titles">
                <text>
                  <text-style ref="ts73">and adapt them to present needs.</text-style>
                </text>
                <text-style-def id="ts73">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="8951/25s" start="0s" duration="108/25s" role="titles">
                <text>
                  <text-style ref="ts74">New workshops or partnerships do
not automatically weaken tradition.</text-style>
                </text>
                <text-style-def id="ts74">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="9076/25s" start="0s" duration="90/25s" role="titles">
                <text>
                  <text-style ref="ts75">Their significance depends on
whether they support the knowledge,</text-style>
                </text>
                <text-style-def id="ts75">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="9166/25s" start="0s" duration="80/25s" role="titles">
                <text>
                  <text-style ref="ts76">relationships and everyday work through which it survives.</text-style>
                </text>
                <text-style-def id="ts76">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="9325/25s" start="0s" duration="104/25s" role="titles">
                <text>
                  <text-style ref="ts77">A twenty twenty-six CNA report
also shows Pek Sin Choon sharing</text-style>
                </text>
                <text-style-def id="ts77">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="9429/25s" start="0s" duration="73/25s" role="titles">
                <text>
                  <text-style ref="ts78">its stories through community programmes.</text-style>
                </text>
                <text-style-def id="ts78">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="9519/25s" start="0s" duration="70/25s" role="titles">
                <text>
                  <text-style ref="ts79">These connections extend beyond the shopfront.</text-style>
                </text>
                <text-style-def id="ts79">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="9606/25s" start="0s" duration="111/25s" role="titles">
                <text>
                  <text-style ref="ts80">They offer one example of how a business
can remain part of present life.</text-style>
                </text>
                <text-style-def id="ts80">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="9734/25s" start="0s" duration="91/25s" role="titles">
                <text>
                  <text-style ref="ts81">The case does not represent every business or resident, and</text-style>
                </text>
                <text-style-def id="ts81">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="9824/25s" start="0s" duration="82/25s" role="titles">
                <text>
                  <text-style ref="ts82">continued operation still needs practical support.</text-style>
                </text>
                <text-style-def id="ts82">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="9982/25s" start="0s" duration="119/25s" role="titles">
                <text>
                  <text-style ref="ts83">Hopefully, Singapore will have more of the heritage businesses
that are here to last.</text-style>
                </text>
                <text-style-def id="ts83">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="10375/25s" start="0s" duration="93/25s" role="titles">
                <text>
                  <text-style ref="ts84">People can agree that Chinatown deserves protection and still</text-style>
                </text>
                <text-style-def id="ts84">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="10468/25s" start="0s" duration="49/25s" role="titles">
                <text>
                  <text-style ref="ts85">disagree about how to protect it.</text-style>
                </text>
                <text-style-def id="ts85">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="10535/25s" start="0s" duration="104/25s" role="titles">
                <text>
                  <text-style ref="ts86">A resident, a shopkeeper, a visitor
and a planning authority may</text-style>
                </text>
                <text-style-def id="ts86">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="10638/25s" start="0s" duration="73/25s" role="titles">
                <text>
                  <text-style ref="ts87">value the same street for different reasons.</text-style>
                </text>
                <text-style-def id="ts87">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="10729/25s" start="0s" duration="46/25s" role="titles">
                <text>
                  <text-style ref="ts88">These identities can overlap.</text-style>
                </text>
                <text-style-def id="ts88">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="10793/25s" start="0s" duration="135/25s" role="titles">
                <text>
                  <text-style ref="ts89">The community is not a single voice, and
no one example can speak for everyone.</text-style>
                </text>
                <text-style-def id="ts89">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="11025/25s" start="0s" duration="144/25s" role="titles">
                <text>
                  <text-style ref="ts90">Public agencies, businesses and cultural
organisations can all provide resources.</text-style>
                </text>
                <text-style-def id="ts90">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="11175/25s" start="0s" duration="95/25s" role="titles">
                <text>
                  <text-style ref="ts91">Their involvement also raises questions about priorities.</text-style>
                </text>
                <text-style-def id="ts91">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="11277/25s" start="0s" duration="97/25s" role="titles">
                <text>
                  <text-style ref="ts92">Being invited to an activity, being asked for an opinion, and</text-style>
                </text>
                <text-style-def id="ts92">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="11374/25s" start="0s" duration="112/25s" role="titles">
                <text>
                  <text-style ref="ts93">being able to change a decision are
different forms of participation.</text-style>
                </text>
                <text-style-def id="ts93">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="11492/25s" start="0s" duration="105/25s" role="titles">
                <text>
                  <text-style ref="ts94">To understand conservation, we
need to examine whose preferences</text-style>
                </text>
                <text-style-def id="ts94">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="11596/25s" start="0s" duration="45/25s" role="titles">
                <text>
                  <text-style ref="ts95">actually shape the choices.</text-style>
                </text>
                <text-style-def id="ts95">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="11675/25s" start="0s" duration="105/25s" role="titles">
                <text>
                  <text-style ref="ts96">Moving out of an old shophouse need
not end a connection with Chinatown.</text-style>
                </text>
                <text-style-def id="ts96">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="11797/25s" start="0s" duration="124/25s" role="titles">
                <text>
                  <text-style ref="ts97">Returning to shop, work or take part
in religious life can also sustain it.</text-style>
                </text>
                <text-style-def id="ts97">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="11939/25s" start="0s" duration="110/25s" role="titles">
                <text>
                  <text-style ref="ts98">These links deserve attention beyond
the streets most visible to visitors.</text-style>
                </text>
                <text-style-def id="ts98">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="12066/25s" start="0s" duration="116/25s" role="titles">
                <text>
                  <text-style ref="ts99">The issue is how a conserved district
remains connected to the people who use it.</text-style>
                </text>
                <text-style-def id="ts99">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="12375/25s" start="0s" duration="113/25s" role="titles">
                <text>
                  <text-style ref="ts100">The next time you walk through
Chinatown, consider three questions.</text-style>
                </text>
                <text-style-def id="ts100">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="12505/25s" start="0s" duration="75/25s" role="titles">
                <text>
                  <text-style ref="ts101">First, who can continue to use this place?</text-style>
                </text>
                <text-style-def id="ts101">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="12598/25s" start="0s" duration="108/25s" role="titles">
                <text>
                  <text-style ref="ts102">Look beyond the appearance of the buildings
to the activities they make possible.</text-style>
                </text>
                <text-style-def id="ts102">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="12724/25s" start="0s" duration="92/25s" role="titles">
                <text>
                  <text-style ref="ts103">A street can carry memory through repeated use, even as the</text-style>
                </text>
                <text-style-def id="ts103">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="12816/25s" start="0s" duration="54/25s" role="titles">
                <text>
                  <text-style ref="ts104">people and their routines change.</text-style>
                </text>
                <text-style-def id="ts104">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="12925/25s" start="0s" duration="100/25s" role="titles">
                <text>
                  <text-style ref="ts105">Second, do the benefits help sustain work and transmission?</text-style>
                </text>
                <text-style-def id="ts105">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="13035/25s" start="0s" duration="100/25s" role="titles">
                <text>
                  <text-style ref="ts106">Visitor numbers show attraction, but they do not explain every</text-style>
                </text>
                <text-style-def id="ts106">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="13135/25s" start="0s" duration="64/25s" role="titles">
                <text>
                  <text-style ref="ts107">cost, or whether skills can be passed on.</text-style>
                </text>
                <text-style-def id="ts107">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="13210/25s" start="0s" duration="81/25s" role="titles">
                <text>
                  <text-style ref="ts108">Third, can different users influence change?</text-style>
                </text>
                <text-style-def id="ts108">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="13301/25s" start="0s" duration="86/25s" role="titles">
                <text>
                  <text-style ref="ts109">Conservation decisions should be examined through their</text-style>
                </text>
                <text-style-def id="ts109">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="13387/25s" start="0s" duration="76/25s" role="titles">
                <text>
                  <text-style ref="ts110">consequences, as well as their stated intentions.</text-style>
                </text>
                <text-style-def id="ts110">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="13500/25s" start="0s" duration="96/25s" role="titles">
                <text>
                  <text-style ref="ts111">These materials lead me to
understand buildings, livelihoods and</text-style>
                </text>
                <text-style-def id="ts111">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="13596/25s" start="0s" duration="52/25s" role="titles">
                <text>
                  <text-style ref="ts112">everyday relationships together.</text-style>
                </text>
                <text-style-def id="ts112">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="13656/25s" start="0s" duration="92/25s" role="titles">
                <text>
                  <text-style ref="ts113">Tourism and cultural display can create opportunities.</text-style>
                </text>
                <text-style-def id="ts113">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="13757/25s" start="0s" duration="104/25s" role="titles">
                <text>
                  <text-style ref="ts114">Their value also depends on the
conditions they leave for continued use.</text-style>
                </text>
                <text-style-def id="ts114">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="13869/25s" start="0s" duration="101/25s" role="titles">
                <text>
                  <text-style ref="ts115">Conserving Chinatown should keep
history visible while allowing</text-style>
                </text>
                <text-style-def id="ts115">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="EN subtitle" lane="2" offset="13970/25s" start="0s" duration="119/25s" role="titles">
                <text>
                  <text-style ref="ts116">people today to practise it, learn from
it, and take part in shaping its future.</text-style>
                </text>
                <text-style-def id="ts116">
                  <text-style font="Helvetica Neue" fontSize="54" fontColor="1 1 1 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 -41.5" scale="1 1" />
              </title>
              <title ref="text" name="Source / context" lane="3" offset="50/25s" start="0s" duration="175/25s" role="titles">
                <text>
                  <text-style ref="ts117">FIELD FOOTAGE · WANG XIWEN  |  CHINATOWN</text-style>
                </text>
                <text-style-def id="ts117">
                  <text-style font="Helvetica Neue" fontSize="31" fontColor="0.75 0.85 0.81 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
