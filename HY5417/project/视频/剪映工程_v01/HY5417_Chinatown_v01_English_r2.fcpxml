                  <text-style ref="ts126">FIELD FOOTAGE · WANG XIWEN  |  CHINATOWN</text-style>
                </text>
                <text-style-def id="ts126">
                  <text-style font="Helvetica Neue" fontSize="31" fontColor="0.75 0.85 0.81 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 46.5" scale="1 1" />
              </title>
              <title ref="text" name="Source / context" lane="3" offset="2900/25s" start="0s" duration="225/25s" role="titles">
                <text>
                  <text-style ref="ts127">CNA · 8 JAN 2025  |  CHINESE NEW YEAR COVERAGE</text-style>
                </text>
                <text-style-def id="ts127">
                  <text-style font="Helvetica Neue" fontSize="31" fontColor="0.75 0.85 0.81 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 46.5" scale="1 1" />
              </title>
              <title ref="text" name="Source / context" lane="3" offset="3125/25s" start="0s" duration="200/25s" role="titles">
                <text>
                  <text-style ref="ts128">CNA · 8 JAN 2025  |  CHINESE NEW YEAR COVERAGE</text-style>
                </text>
                <text-style-def id="ts128">
                  <text-style font="Helvetica Neue" fontSize="31" fontColor="0.75 0.85 0.81 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 46.5" scale="1 1" />
              </title>
              <title ref="text" name="Source / context" lane="3" offset="3325/25s" start="0s" duration="125/25s" role="titles">
                <text>
                  <text-style ref="ts129">FIELD FOOTAGE · WANG XIWEN  |  CHINATOWN</text-style>
                </text>
                <text-style-def id="ts129">
                  <text-style font="Helvetica Neue" fontSize="31" fontColor="0.75 0.85 0.81 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 46.5" scale="1 1" />
              </title>
              <title ref="text" name="Source / context" lane="3" offset="3450/25s" start="0s" duration="200/25s" role="titles">
                <text>
                  <text-style ref="ts130">CNA · 13 MAY 2025  |  HERITAGE CENTRE: RECONSTRUCTED EXHIBITS</text-style>
                </text>
                <text-style-def id="ts130">
                  <text-style font="Helvetica Neue" fontSize="31" fontColor="0.75 0.85 0.81 1" alignment="center" bold="0" shadowColor="0 0 0 0.8" shadowOffset="2 2" shadowBlurRadius="3" />
                </text-style-def>
                <adjust-transform position="0 46.5" scale="1 1" />
              </title>
